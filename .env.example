# -----------------------------------------------------------------------------
# Bay Design Base — copy to .env.local and fill in. NEVER commit .env.local.
# None of these are NEXT_PUBLIC_*, so none of them ever reach the browser.
# -----------------------------------------------------------------------------

# Built-in administrator (not on the roster; can create employees, managers, admins).
ADMIN_LOGIN_ID=admin
ADMIN_DISPLAY_NAME=Administrator
# Generate with:  npm run hash-password   (or: npm run hash-password -- --generate)
ADMIN_PASSWORD_HASH=

# Signs session cookies. 64 random hex characters, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it signs everyone out.
SESSION_SECRET=

# Supabase (Project settings → API Keys). Use the SECRET key (sb_secret_…), server-only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Only for `npm run db:migrate`: Supabase → Connect → "Session pooler" URI with the DB password.
DATABASE_URL=

# Website contact-form email alerts (resend.com ▸ API Keys). Messages are always saved to
# Bay Design Base ▸ Inquiries; this only adds the email copy. onboarding@resend.dev can only
# deliver to your own Resend account's address — verify your domain to send elsewhere.
RESEND_API_KEY=
INQUIRY_EMAIL_TO=
INQUIRY_EMAIL_FROM=Bay Design Store <onboarding@resend.dev>

# Used until the company settings row exists.
APP_TIMEZONE=America/New_York

# Search engine ownership codes (optional). Paste only the content="…" value of the meta tag.
#   Google: search.google.com/search-console ▸ Add property ▸ URL prefix ▸ HTML tag
#   Bing:   bing.com/webmasters ▸ Add site ▸ HTML Meta Tag
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# AI chat assistants (website chat + Bay Design Base assistant). Models are tried in order
# until one answers. NVIDIA first if a key is set (build.nvidia.com ▸ API key, starts nvapi-),
# then OpenRouter's free models (openrouter.ai ▸ Keys). Without either, the website chat
# still answers hours/addresses/phone from the store details.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
OPENROUTER=
OPENROUTER_MODELS=nvidia/nemotron-3.5-lightning:free,google/gemma-4-26b-a4b-it:free,openrouter/free

# Optional: key for the encrypted copy of team passwords that admins can view. Defaults to
# one derived from SESSION_SECRET. Changing it (or SESSION_SECRET) hides stored copies.
PASSWORD_VAULT_KEY=

# Map tiles (carto.com ▸ Basemaps ▸ API key). Sent to browsers with each map tile — restrict it to your domain.
CARTOAPI=
